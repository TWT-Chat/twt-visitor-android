<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/twt_visitor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/twt_visitor_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/twt_visitor_back"
            android:gravity="center"
            android:text="@string/twt_visitor_back_symbol"
            android:textColor="#111827"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/twt_visitor_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/twt_visitor_default_title"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/twt_visitor_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/twt_visitor_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/twt_visitor_load_error"
                android:textColor="#4B5563"
                android:textSize="15sp" />

            <Button
                android:id="@+id/twt_visitor_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/twt_visitor_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
